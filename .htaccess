RewriteEngine On

# If direct file exists, serve it
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Clean URL rewriting for static files without slash
RewriteRule ^signup/?$ signup.html [L]
RewriteRule ^about/?$ about.html [L]
RewriteRule ^faq/?$ faq.html [L]
RewriteRule ^terms/?$ terms.html [L]
